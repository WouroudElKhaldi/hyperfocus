{
  "name": "@hyperfocus/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:routes": "node test/support/route-coverage.mjs",
    "push:keys": "node -e \"const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\\nVAPID_PRIVATE_KEY='+k.privateKey)\"",
    "taxonomy:import": "node --env-file-if-exists=../../.env scripts/taxonomy.ts import",
    "secrets:new-key": "node scripts/secrets.ts new-key",
    "secrets:rotate": "node --env-file-if-exists=../../.env scripts/secrets.ts rotate",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@hyperfocus/ai": "workspace:*",
    "@hyperfocus/db": "workspace:*",
    "@hyperfocus/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.8",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.7",
    "dotenv": "^16.4.5",
    "fflate": "^0.8.3",
    "hono": "^4.13.12",
    "nodemailer": "^10.0.13",
    "pg-boss": "^12.35.1",
    "pino": "^10.3.1",
    "sanitize-html": "^2.18.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hyperfocus/config": "workspace:*",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/smtp-server": "^3.5.13",
    "@types/web-push": "^3.6.4",
    "smtp-server": "^3.19.16",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
