{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "For the React website, bundled by Vite.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"]
  }
}
