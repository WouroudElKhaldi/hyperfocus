  // the guard fails in the database itself instead of quietly giving the row to someone.)
  userId String @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
}

// Every bit of XP she earned. `key` makes each achievement count once (for example "task:12"), so re-ticking never doubles it.
model PetXp {
  id        Int      @id @default(autoincrement())
  key       String
  source    String // task | step | goal | post | study | win | review | skill | book
  amount    Int
  note      String   @default("")
