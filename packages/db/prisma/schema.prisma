// Emails written and sent from her own Gmail. status: draft | sending | sent | failed. `html` is the rich-text body, `body` its plain-text twin (for search and previews).
model Email {
  id          Int               @id @default(autoincrement())
  toAddr      String            @default("")
  ccAddr      String            @default("")
  bccAddr     String            @default("")
  subject     String            @default("")
  html        String            @default("")
  body        String            @default("")
  status      String            @default("draft")
  sentAt      DateTime?
  fromAddr    String            @default("")
  messageId   String            @default("")
  lastError   String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  jobId       Int?
  job         JobApplication?   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  attachments EmailAttachment[]

  // P5-02: whose it is. Every row has an owner; existing rows belong to the owner account ("owner").
  // (P5-03: the tenancy guard writes it. The default reads a setting the app never sets, so an insert that bypasses
  // the guard fails in the database itself instead of quietly giving the row to someone.)
  userId String @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // P4-04: what the app looks rows up by
  @@index([jobId])
  @@index([userId])
}

