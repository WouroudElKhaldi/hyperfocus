}

// A file on an email or a template. `inline` files are images shown inside the body (referenced by the body's <img src>).
model EmailAttachment {
  id         Int            @id @default(autoincrement())
  filename   String
  mime       String         @default("application/octet-stream")
  size       Int            @default(0)
  inline     Boolean        @default(false)
  // P4-07: the bytes are here (database mode, and every file from before), or in the file storage under storageKey
  data       Bytes?
  storageKey String         @default("")
  emailId    Int?
  email      Email?         @relation(fields: [emailId], references: [id], onDelete: Cascade)
  templateId Int?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  // P5-02: whose it is. Every row has an owner; existing rows belong to the owner account ("owner").
  // (P5-03: the tenancy guard writes it. The default reads a setting the app never sets, so an insert that bypasses
  // the guard fails in the database itself instead of quietly giving the row to someone.)
  userId String @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // P4-04: what the app looks rows up by
  @@index([emailId])
  @@index([templateId])
  @@index([userId])
}

// A job she is interested in or has applied to. status: wishlist | applied | interview | offer | rejected | withdrawn.
// Emails sent for it are linked through Email.jobId, which is how she knows she applied.
model JobApplication {
  id           Int       @id @default(autoincrement())
  company      String
  title        String    @default("")
  url          String    @default("")
  location     String    @default("")
  salary       String    @default("")
  source       String    @default("")
  status       String    @default("wishlist")
  appliedAt    DateTime?
  followUpDay  String? // "YYYY-MM-DD"
  contactName  String    @default("")
  contactEmail String    @default("")
  notes        String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  emails       Email[]

  // P5-02: whose it is. Every row has an owner; existing rows belong to the owner account ("owner").
  // (P5-03: the tenancy guard writes it. The default reads a setting the app never sets, so an insert that bypasses
  // the guard fails in the database itself instead of quietly giving the row to someone.)
  userId String @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// P4-06: messages for the outside world (desktop notifications for now), saved in the same transaction as the change that
// causes them, then delivered by a background job (src/outbox.ts). `key` makes each one unique, so none is ever sent twice;
// one that fails stays here and is tried again.
// Features switched on or off for everyone by an admin (P5-06). A flag that doesn't exist yet counts as off.
// A person's connected account (P5-07): Gmail, LinkedIn … One per provider per person. `secret` holds their tokens,
// sealed with AES-256-GCM (apps/api/src/secrets.ts); the key is never in the database.
model Integration {
  id        Int      @id @default(autoincrement())
  userId    String   @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  account   String   @default("")
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

// AI requests per person per day (P5-10), for the daily limit on the app's shared key. `day` is the UTC date.
model AiUsage {
  id       Int    @id @default(autoincrement())
  userId   String @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day      String
  requests Int    @default(0)

  @@unique([userId, day])
}

// A person's settings (P5-11): reminders, accessibility, notification channels. One row per person; `data` holds the
// fields of Settings in @hyperfocus/shared (missing ones take their defaults). Before P5-11 this was one settings.json
// file for everyone; in local mode the owner's file is read once when there is no row yet.
model UserSettings {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// A person's notifications in the app (P5-11): the bell at the top. One per outbox message (same key).
model Notification {
  id        Int       @id @default(autoincrement())
  userId    String    @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  title     String
  body      String    @default("")
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([userId, key])
  @@index([userId, readAt])
}

// A device a person switched web push on for (P5-11): where the browser's push service receives the notification.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String   @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  note      String   @default("")
  updatedAt DateTime @updatedAt
}

model OutboxMessage {
  id        Int       @id @default(autoincrement())
  userId    String    @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  kind      String    @default("notification")
  title     String
  body      String    @default("")
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  attempts  Int       @default(0)
  lastError String    @default("")

  @@unique([userId, key]) // (each person's own: two people's "morning:<day>" are two messages, P5-11)
  @@index([sentAt, id])
  @@index([userId])
}

// ---------- accounts and sign-in (P5-01, Better Auth) ----------
// The four tables Better Auth needs (names and fields as it expects them). In local mode (MODE=local, the default) one
// owner account is made automatically and nobody signs in; in cloud mode people sign up and sign in.
model User {
  id               String             @id
  name             String
  email            String             @unique
  emailVerified    Boolean            @default(false)
  phone            String             @default("") // asked at sign-up (P5-04); empty for the owner and for Google sign-ups
  role             String             @default("user") // "user" or "admin" (P5-06); the owner is an admin
  image            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sessions         Session[]
  accounts         Account[]
  // everything a person owns (P5-02); deleting an account deletes it all (P5-12)
  notes            Note[]
  tasks            Task[]
  steps            Step[]
  posts            Post[]
  studySessions    StudySession[]
  goals            Goal[]
  goalActions      GoalAction[]
  goalLogs         GoalLog[]
  events           Event[]
  books            Book[]
  bookMessages     BookMessage[]
  skills           Skill[]
  reviews          Review[]
  wins             Win[]
  pets             Pet[]
  petXps           PetXp[]
  chatThreads      ChatThread[]
  chatMessages     ChatMessage[]
  profiles         Profile[]
  reminders        Reminder[]
  emails           Email[]
  emailTemplates   EmailTemplate[]
  emailAttachments EmailAttachment[]
  jobApplications  JobApplication[]
  integrations     Integration[]
  aiUsage          AiUsage[]
  settings         UserSettings?
  outbox           OutboxMessage[]
  notifications    Notification[]
  pushDevices      PushSubscription[]
  jobFilters       JobFilter[]
  jobMatches       JobMatch[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------------------------------------------
// The taxonomy (P6-03): every occupation, job title, skill and field of study, seeded from open standards (O*NET,
// ESCO, CIP, GeoNames; see docs/taxonomy.md) by the importer (P6-04). It is the same for everyone (no owner), and
// each row says which dataset and version it came from, so a new release can be imported over it.

enum EmploymentType {
  full_time
  part_time
  internship
  apprenticeship
  contract
  freelance
  volunteer
  student_job
}

enum Seniority {
  student
  intern
  entry
  junior
  mid
  senior
  lead
}

enum WorkMode {
  onsite
  hybrid
  remote
}

enum EducationLevel {
  none
  secondary
  vocational
  associate
  bachelor
  master
  doctorate
}

enum SkillType {
  skill
  knowledge
  tool
  language
  certification
}

/// A browse tree of occupations (SOC major groups, ISCO groups).
model OccupationGroup {
  id          Int               @id @default(autoincrement())
  code        String            @unique // "soc:15-0000", "isco:2512"
  title       String
  parentId    Int?
  parent      OccupationGroup?  @relation("GroupTree", fields: [parentId], references: [id])
  children    OccupationGroup[] @relation("GroupTree")
  occupations Occupation[]
  source      String
  version     String
}

/// One occupation ("Software Developers"). `code` is the dataset's own id: "onet:15-1252.00", "esco:<uuid>".
model Occupation {
  id          Int                      @id @default(autoincrement())
  code        String                   @unique
  title       String
  description String                   @default("")
  /// O*NET job zone 1–5 (how much preparation it needs); null when unknown
  jobZone     Int?
  groupId     Int?
  group       OccupationGroup?         @relation(fields: [groupId], references: [id])
  /// the same occupation in another dataset (ESCO ↔ O*NET, P6-05); titles are shown once
  sameAsId    Int?
  sameAs      Occupation?              @relation("SameAs", fields: [sameAsId], references: [id])
  sameAsOf    Occupation[]             @relation("SameAs")
  titles      OccupationTitle[]
  skills      OccupationSkill[]
  fields      FieldOfStudyOccupation[]
  source      String
  version     String
  updatedAt   DateTime                 @updatedAt

  @@index([groupId])
}

/// Every name an occupation goes by ("Web Developer", "Frontend Engineer"…), per language.
model OccupationTitle {
  id           Int        @id @default(autoincrement())
  occupationId Int
  occupation   Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  title        String
  lang         String     @default("en")
  kind         String     @default("alternative") // preferred | alternative | short

  @@unique([occupationId, lang, title])
  @@index([title])
}

/// A skill, a field of knowledge, a tool or technology, a language, a certification.
model TaxonomySkill {
  id          Int               @id @default(autoincrement())
  code        String            @unique // "onet:2.A.1.a", "onet-tech:Python", "esco:<uuid>"
  type        SkillType
  name        String
  altLabels   String[]          @default([])
  /// O*NET "hot technology": often asked for in job postings
  hot         Boolean           @default(false)
  occupations OccupationSkill[]
  source      String
  version     String

  @@index([name])
}

/// How much an occupation needs a skill: importance 0–1, and whether it is essential.
model OccupationSkill {
  occupationId Int
  occupation   Occupation    @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  skillId      Int
  skill        TaxonomySkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  importance   Float
  essential    Boolean       @default(false)

  @@id([occupationId, skillId])
  @@index([skillId])
}

/// A field of study / major ("Computer Science", CIP 11.0701), in a tree (2, 4 and 6 digits).
model FieldOfStudy {
  id          Int                      @id @default(autoincrement())
  code        String                   @unique // "cip:11.0701", "isced:0613"
  title       String
  description String                   @default("")
  level       Int // 1 = family ("11"), 2 = group ("11.07"), 3 = programme ("11.0701")
  parentId    Int?
  parent      FieldOfStudy?            @relation("FieldTree", fields: [parentId], references: [id])
  children    FieldOfStudy[]           @relation("FieldTree")
  occupations FieldOfStudyOccupation[]
  source      String
  version     String

  @@index([parentId])
}

/// "I study this → these occupations" (the CIP–SOC crosswalk).
model FieldOfStudyOccupation {
  fieldId      Int
  field        FieldOfStudy @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  occupationId Int
  occupation   Occupation   @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@id([fieldId, occupationId])
  @@index([occupationId])
}

/// An industry (NAICS sectors), in a tree.
model Industry {
  id       Int        @id @default(autoincrement())
  code     String     @unique // "naics:54"
  title    String
  parentId Int?
  parent   Industry?  @relation("IndustryTree", fields: [parentId], references: [id])
  children Industry[] @relation("IndustryTree")
  source   String
  version  String
}

/// ISO 3166 countries (from GeoNames).
model Country {
  code      String @id // ISO 3166-1 alpha-2, "LB"
  iso3      String @unique
  name      String
  continent String @default("")
  currency  String @default("")
  languages String @default("")
  cities    City[]
  version   String
}

/// Cities with 15,000+ people (GeoNames), for job locations.
model City {
  id          Int     @id // the GeoNames id
  name        String
  asciiName   String
  countryCode String
  country     Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  admin1      String  @default("")
  lat         Float
  lng         Float
  population  Int     @default(0)
  version     String

  @@index([countryCode])
  @@index([asciiName])
}

/// One run of the importer: which dataset and version, and what changed.
model TaxonomyImport {
  id         Int       @id @default(autoincrement())
  dataset    String // onet | esco | cip | geo | industries
  version    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  changes    Json      @default("{}")
}

// ---------------------------------------------------------------------------------------------------------------
// Job Radar (P6-10, P6-20). Postings are the same for everyone (no owner); each person's filters and matches are theirs.

/// Where postings come from: one row per source (and per company board: "greenhouse:gitlab").
model JobSource {
  id        Int           @id @default(autoincrement())
  key       String        @unique // "arbeitnow", "greenhouse:gitlab", "lever:spotify"
  kind      String // arbeitnow | greenhouse | lever | linkedin …
  name      String
  /// what the adapter needs (a board's name…), never a secret
  config    Json          @default("{}")
  enabled   Boolean       @default(true)
  lastRunAt DateTime?
  lastOkAt  DateTime?
  lastError String        @default("")
  lastItems Int           @default(0)
  postings  JobPosting[]
  batches   IngestBatch[]
  createdAt DateTime      @default(now())
}

/// One job ad, normalised from its source (the raw item is kept to re-process it).
model JobPosting {
  id              Int               @id @default(autoincrement())
  sourceId        Int
  source          JobSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String
  url             String
  title           String
  company         String            @default("")
  description     String            @default("") // plain text
  locationText    String            @default("")
  countryCode     String            @default("")
  cityId          Int?
  workMode        WorkMode?
  employmentType  EmploymentType?
  seniority       Seniority?
  educationLevel  EducationLevel?
  yearsMin        Int?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String            @default("")
  salaryPeriod    String            @default("") // year | month | hour
  visaSponsorship Boolean?
  occupationId    Int?
  postedAt        DateTime
  expiresAt       DateTime
  /// the same job seen before (from another source, or reposted): matches use the first one
  duplicateOfId   Int?
  contentHash     String
  archivedAt      DateTime?
  raw             Json              @default("{}")
  skills          JobPostingSkill[]
  matches         JobMatch[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([sourceId, externalId])
  @@index([contentHash])
  @@index([postedAt])
  @@index([expiresAt])
  @@index([occupationId])
}

/// A skill a posting asks for (found by the skill extractor, P6-14).
model JobPostingSkill {
  postingId Int
  posting   JobPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  skillId   Int
  /// how it was found: dictionary | ai
  via       String     @default("dictionary")

  @@id([postingId, skillId])
  @@index([skillId])
}

/// One delivery of postings (from a fetch job, or POSTed by n8n): replaying the same key changes nothing.
model IngestBatch {
  id             Int       @id @default(autoincrement())
  sourceId       Int
  source         JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  idempotencyKey String    @unique
  cursor         String    @default("")
  received       Int       @default(0)
  created        Int       @default(0)
  updated        Int       @default(0)
  duplicates     Int       @default(0)
  failed         Int       @default(0)
  errors         Json      @default("[]")
  status         String    @default("queued") // queued | done | failed
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?
}

/// A person's Job Radar filter (P6-20): what they look for (JobFilterSpec in @hyperfocus/shared).
model JobFilter {
  id        Int        @id @default(autoincrement())
  userId    String     @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  enabled   Boolean    @default(true)
  spec      Json       @default("{}")
  /// skill weights learned from 👍/👎 (P6-26)
  weights   Json       @default("{}")
  matches   JobMatch[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

/// A posting that fits one of a person's filters, with why (P6-22) and what they did with it.
model JobMatch {
  id            Int        @id @default(autoincrement())
  userId        String     @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  filterId      Int
  filter        JobFilter  @relation(fields: [filterId], references: [id], onDelete: Cascade)
  postingId     Int
  posting       JobPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  score         Float
  reasons       Json       @default("[]")
  status        String     @default("new") // new | seen | saved | dismissed | applied
  /// 👍 +1 / 👎 -1 (P6-26)
  feedback      Int        @default(0)
  /// the Job application it became (P6-25)
  applicationId Int?
  notifiedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([filterId, postingId])
  @@index([userId, status])
}
