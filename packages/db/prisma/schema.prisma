generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// kind: thought | note | post_idea | project_idea
model Note {
  id        Int      @id @default(autoincrement())
  kind      String   @default("thought")
  title     String   @default("")
  body      String
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false) // hidden from the main list (kept, never deleted)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  // P5-02: whose it is. Every row has an owner; existing rows belong to the owner account ("owner").
  // (P5-03: the tenancy guard writes it. The default reads a setting the app never sets, so an insert that bypasses
  // the guard fails in the database itself instead of quietly giving the row to someone.)
  userId String @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // P4-04: what the app looks rows up by
  @@index([kind])
  @@index([userId])
}

model Task {
  id        Int       @id @default(autoincrement())
  title     String
  done      Boolean   @default(false)
  today     Boolean   @default(false)
  createdAt DateTime  @default(now())
  doneAt    DateTime?
  dueDay    String? // "YYYY-MM-DD", shown on the calendar
  priority  String    @default("normal") // low | normal | high | urgent: more important tasks earn more points
  steps     Step[]

  // P5-02: whose it is. Every row has an owner; existing rows belong to the owner account ("owner").
  // (P5-03: the tenancy guard writes it. The default reads a setting the app never sets, so an insert that bypasses
  // the guard fails in the database itself instead of quietly giving the row to someone.)
  userId String @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // P4-04: what the app looks rows up by
  @@index([dueDay])
  @@index([done, today])
  @@index([doneAt])
  @@index([userId])
}

model Step {
  id     Int     @id @default(autoincrement())
  text   String
  done   Boolean @default(false)
  taskId Int
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // P5-02: whose it is. Every row has an owner; existing rows belong to the owner account ("owner").
  // (P5-03: the tenancy guard writes it. The default reads a setting the app never sets, so an insert that bypasses
  // the guard fails in the database itself instead of quietly giving the row to someone.)
  userId String @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // P4-04: what the app looks rows up by
  @@index([taskId])
  @@index([userId])
}

// `thought` is the user's original words and is never overwritten by AI. `draft` is the editable LinkedIn version.
model Post {
  id            Int       @id @default(autoincrement())
  thought       String
  draft         String    @default("")
  status        String    @default("draft") // draft | scheduled | posting | posted | failed | missed
  postedAt      DateTime?
  scheduledAt   DateTime? // when the app should auto-post it
  attempts      Int       @default(0)
  lastError     String    @default("")
  lastAttemptAt DateTime?
  noteId        Int?
  note          Note?     @relation(fields: [noteId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // P5-02: whose it is. Every row has an owner; existing rows belong to the owner account ("owner").
  // (P5-03: the tenancy guard writes it. The default reads a setting the app never sets, so an insert that bypasses
  // the guard fails in the database itself instead of quietly giving the row to someone.)
  userId String @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // P4-04: what the app looks rows up by
  @@index([status, scheduledAt])
  @@index([postedAt])
  @@index([noteId])
  @@index([userId])
}

