  notes     String    @default("")
  startedAt DateTime
  endedAt   DateTime?
  breakMs   Int       @default(0) // total time spent on breaks, NOT counted as study time
  pausedAt  DateTime? // set while the timer is paused (a break is in progress)
  createdAt DateTime  @default(now())

  // P5-02: whose it is. Every row has an owner; existing rows belong to the owner account ("owner").
  // (P5-03: the tenancy guard writes it. The default reads a setting the app never sets, so an insert that bypasses
  // the guard fails in the database itself instead of quietly giving the row to someone.)
  userId String @default(dbgenerated("current_setting('hyperfocus.user_id')"))
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // P4-04: what the app looks rows up by
  @@index([startedAt])
  @@index([endedAt])
  @@index([userId])
}

// A goal: original = her own words (never overwritten), refined = AI's sharper wording.
// verdict: achievable | stretch | unrealistic (AI's honest read, given the date)
