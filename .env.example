# Hyperfocus settings. Copy this file to .env (in this same folder, the project root) and fill it in.
# This is the one settings file: the API reads it at start-up and refuses to start, with a message saying what to fix,
# if a value is wrong. Real environment variables win over this file. (packages/db/.env is only for the Prisma CLI.)

# The database: the PostgreSQL on this computer (`pnpm db:setup` creates the user and the database, no Docker).
DATABASE_URL="postgresql://hyperfocus:hyperfocus-local@localhost:5432/hyperfocus"
# The API's port (the website finds it through API_PORT, default 4000)
PORT=4000

# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# n8n webhook that posts to LinkedIn (see n8n/README.md). Leave empty to use copy + open LinkedIn.
N8N_WEBHOOK_URL=

# Optional, free: https://console.cloud.google.com (Books API). Only needed if Google Books keeps saying "busy".
GOOGLE_BOOKS_API_KEY=

# Email (Gmail): your address and an App Password from https://myaccount.google.com/apppasswords (needs 2-Step Verification)
GMAIL_USER=
GMAIL_APP_KEY=

# How much the API logs: silent, error, warn, info (default) or debug
LOG_LEVEL=info

# Security (optional, the defaults suit running on your own computer)
# Web pages allowed to call the API from another address, separated by commas. Empty = pages on this computer only.
CORS_ORIGINS=
# Requests per minute per visitor, and for the routes that call the AI (each costs DeepSeek credits). Defaults: 600 and 30.
RATE_LIMIT_PER_MINUTE=
AI_RATE_LIMIT_PER_MINUTE=

# Where uploaded files (email attachments) are kept. Empty or "database" = inside the database (in every backup, nothing
# else to set up). "disk" = a folder (FILE_STORAGE_DIR, default: the storage folder in the project; back it up too).
# "s3" = S3-compatible storage for a hosted app (Cloudflare R2, Backblaze B2, MinIO, AWS S3): files survive redeploys.
FILE_STORAGE=
FILE_STORAGE_DIR=
# For FILE_STORAGE=s3 (R2: https://<account id>.r2.cloudflarestorage.com, region auto)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Who uses this copy (APP_MODE). local (default) = just you on this computer: no sign-in, works like before.
# cloud = people sign up and sign in. Needs BETTER_AUTH_SECRET (32+ random characters) and PUBLIC_URL (the site's address).
APP_MODE=
BETTER_AUTH_SECRET=
PUBLIC_URL=
# Optional, cloud mode: "Sign in with Google" (https://console.cloud.google.com → APIs & Services → Credentials → OAuth
# client ID, web application; authorised redirect URI: <PUBLIC_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, cloud mode: emails of the people who are always admins (comma separated). Admins see the admin area.
ADMIN_EMAILS=
# The key that seals each person's tokens (Gmail, LinkedIn) in the database (P5-07). Needed in cloud mode; in local mode
# a key is made once in apps/api/secrets.key. Format: id:key,id:key (first one seals). Make one: pnpm secrets:new-key
# Rotate: put the new key first, keep the old one after it, run pnpm secrets:rotate, then remove the old one.
SECRETS_KEYS=
# AI requests a day per person on the app's own DeepSeek key (P5-10). 0 = no limit. Empty: 30 in cloud mode, no limit
# in local mode. People who add their own key in Settings → Connections have no limit.
AI_DAILY_LIMIT=
