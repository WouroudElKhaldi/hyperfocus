# Hyperfocus settings. Copy this file to .env (in this same folder, the project root) and fill it in.
# This is the one settings file: the API reads it at start-up and refuses to start, with a message saying what to fix,
# if a value is wrong. Real environment variables win over this file. (packages/db/.env is only for the Prisma CLI.)

# The database. The path is relative to packages/db/prisma, so this is packages/db/prisma/dev.db.
DATABASE_URL="file:./dev.db"
# The API's port (the website finds it through API_PORT, default 4000)
PORT=4000

# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# n8n webhook that posts to LinkedIn (see n8n/README.md). Leave empty to use copy + open LinkedIn.
N8N_WEBHOOK_URL=

# Optional, free: https://console.cloud.google.com (Books API). Only needed if Google Books keeps saying "busy".
GOOGLE_BOOKS_API_KEY=

# Email (Gmail): your address and an App Password from https://myaccount.google.com/apppasswords (needs 2-Step Verification)
GMAIL_USER=
GMAIL_APP_KEY=

# How much the API logs: silent, error, warn, info (default) or debug
LOG_LEVEL=info
