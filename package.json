{
  "name": "thought-studio",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "bootstrap": "pnpm install && pnpm --filter ./apps/api db:push",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && playwright test",
    "test:api": "turbo run test --filter=./apps/api",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "turbo": "^2.11.6"
  }
}
