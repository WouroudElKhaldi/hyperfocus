{
  "name": "hyperfocus",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "bootstrap": "pnpm install && pnpm --filter @hyperfocus/db db:push",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && playwright test",
    "test:api": "turbo run test --filter=./apps/api",
    "test:packages": "turbo run test --filter=./packages/*",
    "test:e2e": "playwright test",
    "lint": "turbo run lint //#lint:root",
    "lint:root": "biome lint e2e scripts playwright.config.js",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write",
    "check": "turbo run lint //#lint:root typecheck test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "lefthook": "^2.1.15",
    "turbo": "^2.11.6",
    "typescript": "^7.0.2"
  }
}
