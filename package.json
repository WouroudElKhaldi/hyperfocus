{
  "name": "hyperfocus",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "bootstrap": "pnpm install && pnpm --filter @hyperfocus/db db:push",
    "api:types": "node apps/api/scripts/api-types.mjs",
    "dev": "turbo run dev",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait db",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:admin": "docker compose -f infra/docker-compose.yml --profile admin up -d --wait",
    "build": "turbo run build",
    "test": "turbo run test && playwright test --project=desktop --project=phone",
    "test:api": "turbo run test --filter=./apps/api",
    "test:packages": "turbo run test --filter=./packages/*",
    "test:e2e": "playwright test --project=desktop --project=phone",
    "test:visual": "playwright test --project=visual",
    "lint": "turbo run lint //#lint:root",
    "lint:root": "biome lint e2e scripts playwright.config.js",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write",
    "check": "turbo run lint //#lint:root typecheck test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "lefthook": "^2.1.15",
    "openapi-typescript": "^7.13.0",
    "turbo": "^2.11.6",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.3"
  }
}
