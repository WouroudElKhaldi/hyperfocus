{
  "name": "hyperfocus",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "bootstrap": "pnpm install && pnpm db:setup && pnpm --filter @hyperfocus/db db:migrate",
    "api:types": "node apps/api/scripts/api-types.mjs",
    "secrets:new-key": "pnpm --filter @hyperfocus/api secrets:new-key",
    "push:keys": "pnpm --filter @hyperfocus/api push:keys",
    "secrets:rotate": "pnpm --filter @hyperfocus/api secrets:rotate",
    "dev": "turbo run dev",
    "db:setup": "node scripts/db.mjs setup",
    "db:check": "node scripts/db.mjs check",
    "db:restore": "node scripts/db.mjs restore",
    "build": "turbo run build",
    "test": "turbo run test && playwright test --project=desktop --project=phone",
    "test:api": "turbo run test --filter=./apps/api",
    "test:packages": "turbo run test --filter=./packages/*",
    "test:e2e": "playwright test --project=desktop --project=phone --project=cloud",
    "test:visual": "playwright test --project=visual",
    "lint": "turbo run lint //#lint:root",
    "lint:root": "biome lint e2e scripts playwright.config.js",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write",
    "check": "turbo run lint //#lint:root typecheck test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "lefthook": "^2.1.15",
    "openapi-typescript": "^7.13.0",
    "turbo": "^2.11.6",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.3"
  }
}
